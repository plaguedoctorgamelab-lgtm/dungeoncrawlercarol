extends Node
## Sound effects, music and the small settings file (volumes, screen shake).
## All audio is original chiptune generated by tools/synth_audio.py into res://assets/audio/.
## Missing files are skipped silently, so the game never errors on audio.

const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"
const SETTINGS_PATH := "user://settings.cfg"
const SFX_VOICES := 10
const REALM_TRACKS: Array[String] = ["earth", "air", "fire", "water"]

var music_volume: float = 0.7
var sfx_volume: float = 0.8
var screen_shake: bool = true

var _sfx_players: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _music: AudioStreamPlayer
var _music_id: String = ""
var _cache: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus("Music")
	_ensure_bus("SFX")
	for i in SFX_VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_sfx_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	load_settings()


## Release streams on exit so the engine shuts down without leaked resources.
func _exit_tree() -> void:
	for p in _sfx_players:
		p.stop()
		p.stream = null
	if _music:
		_music.stop()
		_music.stream = null
	_cache.clear()


func _ensure_bus(bus_name: String) -> void:
	if AudioServer.get_bus_index(bus_name) == -1:
		AudioServer.add_bus()
		var i := AudioServer.bus_count - 1
		AudioServer.set_bus_name(i, bus_name)
		AudioServer.set_bus_send(i, "Master")


func _stream(path: String) -> AudioStream:
	if _cache.has(path):
		return _cache[path]
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	_cache[path] = s
	return s


func has_sfx(id: String) -> bool:
	return _stream(SFX_DIR + id + ".wav") != null


func has_music(id: String) -> bool:
	return _stream(MUSIC_DIR + id + ".wav") != null


## Plays a one-shot effect with a little random pitch so repeats don't sound robotic.
func play_sfx(id: String, pitch_jitter: float = 0.06) -> void:
	var s := _stream(SFX_DIR + id + ".wav")
	if s == null or _sfx_players.is_empty():
		return
	var p := _sfx_players[_next_voice]
	_next_voice = (_next_voice + 1) % _sfx_players.size()
	p.stream = s
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


func realm_track(realm: int) -> String:
	return REALM_TRACKS[clampi(realm, 0, REALM_TRACKS.size() - 1)]


## Switches music (no-op if the track is already playing). `loop` is false for jingles.
func play_music(id: String, loop: bool = true) -> void:
	if _music == null:
		return
	if id == _music_id and _music.playing:
		return
	var s := _stream(MUSIC_DIR + id + ".wav")
	if s == null:
		return
	if s is AudioStreamWAV:
		var wav := s as AudioStreamWAV
		if loop:
			wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
			wav.loop_begin = 0
			wav.loop_end = int(wav.get_length() * wav.mix_rate)
		else:
			wav.loop_mode = AudioStreamWAV.LOOP_DISABLED
	_music_id = id
	_music.stream = s
	_music.play()


func stop_music() -> void:
	_music_id = ""
	if _music:
		_music.stop()


func current_music() -> String:
	return _music_id


# ------------------------------------------------------------------ settings

func set_music_volume(v: float) -> void:
	music_volume = clampf(v, 0.0, 1.0)
	_apply()


func set_sfx_volume(v: float) -> void:
	sfx_volume = clampf(v, 0.0, 1.0)
	_apply()


func _apply() -> void:
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Music"), linear_to_db(maxf(music_volume, 0.0001)))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), linear_to_db(maxf(sfx_volume, 0.0001)))


func load_settings() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) == OK:
		music_volume = float(cfg.get_value("audio", "music", music_volume))
		sfx_volume = float(cfg.get_value("audio", "sfx", sfx_volume))
		screen_shake = bool(cfg.get_value("video", "screen_shake", screen_shake))
	_apply()


func save_settings() -> void:
	var cfg := ConfigFile.new()
	cfg.set_value("audio", "music", music_volume)
	cfg.set_value("audio", "sfx", sfx_volume)
	cfg.set_value("video", "screen_shake", screen_shake)
	cfg.save(SETTINGS_PATH)
